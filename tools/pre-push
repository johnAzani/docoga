#!/bin/sh
# DocOga pre-push gate — refuses to push if QA fails OR the repo is missing
# files / about to lose files.
#
# Install (git does not run hooks straight from tools/):
#   ln -sf ../../tools/pre-push .git/hooks/pre-push
# or:
#   cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# NOTE: a local hook is a convenience, not a control — it is trivially
# bypassed with --no-verify and is absent on a fresh clone. The authoritative
# gate is .github/workflows/verify.yml, which runs the same checks in CI on
# every push and pull request.

set -e

# Resolve the repo root so this works whether it is invoked as
# .git/hooks/pre-push or directly as tools/pre-push.
ROOT=$(git rev-parse --show-toplevel)
FAIL=0

if [ -f "$ROOT/tools/qa.py" ]; then
    echo "── qa.py ─────────────────────────────────────────"
    python3 "$ROOT/tools/qa.py" || FAIL=1
else
    echo "⚠️  tools/qa.py not found — skipping QA"
fi

if [ -f "$ROOT/tools/pre_push_verify.sh" ]; then
    echo ""
    echo "── pre_push_verify.sh ────────────────────────────"
    bash "$ROOT/tools/pre_push_verify.sh" || FAIL=1
else
    echo "⚠️  tools/pre_push_verify.sh not found — skipping verification"
fi

if [ "$FAIL" -ne 0 ]; then
    echo ""
    echo "❌ Push blocked. Fix the issues above, or bypass deliberately with:"
    echo "     git push --no-verify"
    exit 1
fi

exit 0
