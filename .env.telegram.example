# DocOga Telegram Automation - Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID (from @username_to_id_bot)
# Can be: @channelusername or -1001234567890
TELEGRAM_CHAT_ID=your_channel_id_here

# Optional: Timezone (default: Africa/Lagos)
TZ=Africa/Lagos
