<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing may leave the device, including the WebView's localStorage (where the
     12-hour dashboard session token lives). Android 12+ reads this file;
     allowBackup=false covers the older paths. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="webview" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="webview" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
